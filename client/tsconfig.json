{
"compilerOptions": {
  "target": "es6",
  "lib": ["dom", "dom.iterable", "esnext"],
  "allowJs": true,
  "skipLibCheck": true,
  "strict": true,
  "forceConsistentCasingInFileNames": true,
  "noEmit": true,
  "esModuleInterop": true,
  "module": "esnext",
  "moduleResolution": "node",
  "resolveJsonModule": true,
  "jsx": "react-jsx",
  "isolatedModules": true,
  "types": ["react", "react-dom"]
}
,
  "include": [
    "src/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.d.ts",  // Include this line if you have a types directory
    "src/middleware/route.js"
, "src/pages/OPT.JSX"  ]

}
